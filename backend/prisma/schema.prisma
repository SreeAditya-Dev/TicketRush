generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seat {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  isBooked  Boolean   @default(false)
  bookedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  userId    String
  seatId    Int
  eventId   String
  date      String
  time      String
  createdAt DateTime @default(now())
  seat      Seat     @relation(fields: [seatId], references: [id])

  @@unique([seatId, eventId, date, time])
}

model Event {
  id          String   @id
  title       String
  artist      String
  date        String
  time        String
  venue       String
  image       String
  price       String
  priceValue  Int
  category    String
  tags        String[]
  rating      Float
  eventType   String   @default("seated")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}